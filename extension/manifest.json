{
  "manifest_version": 3,
  "name": "margin",
  "version": "0.1.0",
  "description": "Sits in the margin of a lecture. Jot as you go; the TA answers and checks under your notes.",
  "browser_specific_settings": {
    "gecko": {
      "id": "margin@kaushikbhat.com",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "48": "icons/ta.svg",
    "96": "icons/ta.svg"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "sidebar_action": {
    "default_title": "margin",
    "default_panel": "sidebar/panel.html",
    "default_icon": "icons/ta.svg",
    "open_at_install": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content/youtube.js"
      ],
      "run_at": "document_idle"
    }
  ]
}