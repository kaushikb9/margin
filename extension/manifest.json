{
  "manifest_version": 3,
  "name": "margin",
  "version": "0.1.4",
  "description": "Sits in the margin of a lecture. Jot as you go; the TA answers and checks under your notes.",
  "browser_specific_settings": {
    "gecko": {
      "id": "margin@kaushikbhat.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteActivity"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/margin-48.png",
    "96": "icons/margin-96.png",
    "128": "icons/margin-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "sidebar_action": {
    "default_title": "margin",
    "default_panel": "sidebar/panel.html",
    "default_icon": "icons/margin.svg",
    "open_at_install": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content/youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://www.youtube.com/*"
  ]
}